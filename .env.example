# Copy this file to .env and fill in real values. Never commit .env.

# --- AWS ---
# AWS credentials are loaded from ~/.aws/credentials (set by `aws configure`).
# Do NOT put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here — env vars take precedence
# over ~/.aws/credentials, so leaving placeholder strings would break boto3 silently.
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name-here

# --- Google Cloud / BigQuery ---
# Service account JSON path (absolute path on your machine)
GOOGLE_APPLICATION_CREDENTIALS=/Users/derekkuang/.config/gcp/crypto-de-sa.json
GCP_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=US

# Three datasets follow the medallion pattern: raw -> staging -> marts
BQ_DATASET_RAW=crypto_raw
BQ_DATASET_STAGING=crypto_staging
BQ_DATASET_MARTS=crypto_marts

# --- Coinbase ---
# Public endpoints don't require auth. Uncomment if you hit rate limits and need higher quotas.
# COINBASE_API_KEY=
# COINBASE_API_SECRET=

# --- Project ---
ENVIRONMENT=local
LOG_LEVEL=INFO
