# Copy this file to .env and fill in real values. Never commit .env.

# --- AWS ---
# AWS credentials are loaded from ~/.aws/credentials (set by `aws configure`).
# Do NOT put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here — env vars take precedence
# over ~/.aws/credentials, so leaving placeholder strings would break boto3 silently.
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name-here

# --- Athena (warehouse) ---
# Filled in during Phase 5 (see docs/setup/03-athena-s3.md). No password — Athena
# auth uses the AWS credential chain (~/.aws/credentials), same as ingestion.
# Glue dbs follow the medallion pattern: crypto_raw -> staging -> marts.
ATHENA_WORKGROUP=crypto_wg
ATHENA_DATABASE=crypto_raw
ATHENA_S3_STAGING_DIR=s3://your-bucket-name-here/athena-results/

# --- Coinbase ---
# Public endpoints don't require auth. Uncomment if you hit rate limits and need higher quotas.
# COINBASE_API_KEY=
# COINBASE_API_SECRET=

# --- Project ---
ENVIRONMENT=local
LOG_LEVEL=INFO
