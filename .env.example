# Copy this file to .env and fill in real values. Never commit .env.

# --- AWS ---
# AWS credentials are loaded from ~/.aws/credentials (set by `aws configure`).
# Do NOT put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here — env vars take precedence
# over ~/.aws/credentials, so leaving placeholder strings would break boto3 silently.
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name-here

# --- Snowflake (warehouse) ---
# Filled in during Phase 4 (see docs/setup/02-snowflake-s3.md). Schemas follow
# the medallion pattern: raw -> staging -> marts (inside crypto_db).
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-user
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=crypto_wh
SNOWFLAKE_DATABASE=crypto_db

# --- Coinbase ---
# Public endpoints don't require auth. Uncomment if you hit rate limits and need higher quotas.
# COINBASE_API_KEY=
# COINBASE_API_SECRET=

# --- Project ---
ENVIRONMENT=local
LOG_LEVEL=INFO
